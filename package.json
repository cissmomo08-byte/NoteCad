{
  "name": "notecad",
  "version": "0.2.0",
  "private": true,
  "description": "Atelier de conception 2D et 3D NoteCad",
  "author": "NoteCad",
  "license": "UNLICENSED",
  "main": "electron-main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg zip --universal",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.notecad.desktop",
    "productName": "NoteCad",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "electron-main.cjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoteCad"
    },
    "linux": {
      "category": "Graphics",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
